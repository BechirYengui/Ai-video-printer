# Auto detect text files and normalize line endings in the repository
* text=auto

# Binary assets
*.mp3 binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.ttc binary
*.otf binary
*.woff binary
*.woff2 binary

# Scripts Windows : fins de ligne CRLF (PowerShell 5.1 et cmd), y compris depuis Linux
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
